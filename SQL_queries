CREATE DATABASE hospital_readmission;
USE hospital_readmission;

SELECT COUNT(*) FROM patient_data;
select * from  patient_data;


***Group 1 — Overall Readmission Summary*** 

-- 1. Overall readmission rate
SELECT 
    COUNT(*) AS total_patients,
    SUM(readmitted_binary) AS total_readmitted,
    ROUND(100.0 * SUM(readmitted_binary) / COUNT(*), 2) AS readmission_rate
FROM patient_data;

-- 2. Readmission breakdown by category
SELECT 
    readmitted,
    COUNT(*) AS total_patients,
    ROUND(100.0 * COUNT(*) / (SELECT COUNT(*) FROM patient_data), 2) AS percentage
FROM patient_data
GROUP BY readmitted;

-- 3. Average length of stay — readmitted vs not
SELECT 
    CASE WHEN readmitted_binary = 1 THEN 'Readmitted'
         ELSE 'Not Readmitted' END AS patient_group,
    ROUND(AVG(time_in_hospital), 2) AS avg_length_of_stay,
    ROUND(AVG(num_medications), 2) AS avg_medications,
    ROUND(AVG(number_diagnoses), 2) AS avg_diagnoses
FROM patient_data
GROUP BY readmitted_binary;




***Group 2 — Patient Demographics***

-- 1. Readmission rate by age group
SELECT 
    age,
    COUNT(*) AS total_patients,
    SUM(readmitted_binary) AS total_readmitted,
    ROUND(100.0 * SUM(readmitted_binary) / COUNT(*), 2) AS readmission_rate
FROM patient_data
GROUP BY age
ORDER BY readmission_rate DESC;

-- 2. Readmission rate by gender
SELECT 
    gender,
    COUNT(*) AS total_patients,
    SUM(readmitted_binary) AS total_readmitted,
    ROUND(100.0 * SUM(readmitted_binary) / COUNT(*), 2) AS readmission_rate
FROM patient_data
GROUP BY gender
ORDER BY readmission_rate DESC;

-- 3. Readmission rate by race
SELECT 
    race,
    COUNT(*) AS total_patients,
    SUM(readmitted_binary) AS total_readmitted,
    ROUND(100.0 * SUM(readmitted_binary) / COUNT(*), 2) AS readmission_rate
FROM patient_data
GROUP BY race
ORDER BY readmission_rate DESC;

-- 4. High risk elderly patients
-- Who are the highest risk patients combining age and gender?
SELECT 
    age,
    gender,
    COUNT(*) AS total_patients,
    SUM(readmitted_binary) AS total_readmitted,
    ROUND(100.0 * SUM(readmitted_binary) / COUNT(*), 2) AS readmission_rate
FROM patient_data
WHERE age IN ('[60-70)', '[70-80)', '[80-90)', '[90-100)')
GROUP BY age, gender
ORDER BY readmission_rate DESC;




***Group 3 — Clinical & Hospital Stay***

-- 1. Readmission rate by stay category
SELECT 
    stay_category,
    COUNT(*) AS total_patients,
    SUM(readmitted_binary) AS total_readmitted,
    ROUND(100.0 * SUM(readmitted_binary) / COUNT(*), 2) AS readmission_rate
FROM patient_data
GROUP BY stay_category
ORDER BY readmission_rate DESC;

-- 2. Average stay length — readmitted vs not
SELECT 
    CASE WHEN readmitted_binary = 1 THEN 'Readmitted'
         ELSE 'Not Readmitted' END AS patient_group,
    ROUND(AVG(time_in_hospital), 2) AS avg_days_in_hospital
FROM patient_data
GROUP BY readmitted_binary;

-- 3. Readmission rate by number of diagnoses
SELECT 
    number_diagnoses,
    COUNT(*) AS total_patients,
    SUM(readmitted_binary) AS total_readmitted,
    ROUND(100.0 * SUM(readmitted_binary) / COUNT(*), 2) AS readmission_rate
FROM patient_data
GROUP BY number_diagnoses
ORDER BY number_diagnoses;

-- 4. Readmission rate by severity bucket
SELECT 
    severity_bucket,
    COUNT(*) AS total_patients,
    SUM(readmitted_binary) AS total_readmitted,
    ROUND(100.0 * SUM(readmitted_binary) / COUNT(*), 2) AS readmission_rate
FROM patient_data
GROUP BY severity_bucket
ORDER BY readmission_rate DESC;

-- 5. High risk vs low risk patients
SELECT 
    CASE WHEN high_risk = 1 THEN 'High Risk'
         ELSE 'Low Risk' END AS risk_group,
    COUNT(*) AS total_patients,
    SUM(readmitted_binary) AS total_readmitted,
    ROUND(100.0 * SUM(readmitted_binary) / COUNT(*), 2) AS readmission_rate
FROM patient_data
GROUP BY high_risk;

-- 6. Most complex patients — highest diagnoses and medications
-- These patients are most likely to be readmitted
SELECT 
    age,
    number_diagnoses,
    num_medications,
    severity_bucket,
    ROUND(100.0 * SUM(readmitted_binary) / COUNT(*), 2) AS readmission_rate
FROM patient_data
WHERE number_diagnoses >= 7
AND num_medications >= 15
GROUP BY age, number_diagnoses, num_medications, severity_bucket
ORDER BY readmission_rate DESC
LIMIT 10;



***Group 4 — Admission & Discharge***

-- 1. Readmission rate by admission type
SELECT 
    admission_type,
    COUNT(*) AS total_patients,
    SUM(readmitted_binary) AS total_readmitted,
    ROUND(100.0 * SUM(readmitted_binary) / COUNT(*), 2) AS readmission_rate
FROM patient_data
GROUP BY admission_type
ORDER BY readmission_rate DESC;

-- 2. Readmission rate by admission source
SELECT 
    admission_source_group,
    COUNT(*) AS total_patients,
    SUM(readmitted_binary) AS total_readmitted,
    ROUND(100.0 * SUM(readmitted_binary) / COUNT(*), 2) AS readmission_rate
FROM patient_data
GROUP BY admission_source_group
ORDER BY readmission_rate DESC;

-- 3. Readmission rate by discharge group
SELECT 
    discharge_group,
    COUNT(*) AS total_patients,
    SUM(readmitted_binary) AS total_readmitted,
    ROUND(100.0 * SUM(readmitted_binary) / COUNT(*), 2) AS readmission_rate
FROM patient_data
GROUP BY discharge_group
ORDER BY readmission_rate DESC;

-- 4. Most dangerous combination — admission type + discharge group
-- Which entry and exit combination produces highest readmission?
SELECT 
    admission_type,
    discharge_group,
    COUNT(*) AS total_patients,
    SUM(readmitted_binary) AS total_readmitted,
    ROUND(100.0 * SUM(readmitted_binary) / COUNT(*), 2) AS readmission_rate
FROM patient_data
GROUP BY admission_type, discharge_group
HAVING COUNT(*) >= 50
ORDER BY readmission_rate DESC
LIMIT 10;

-- 5. Patients who left against medical advice (AMA)
-- These patients are incomplete treatment — high risk group
SELECT 
    age,
    gender,
    COUNT(*) AS total_patients,
    SUM(readmitted_binary) AS total_readmitted,
    ROUND(100.0 * SUM(readmitted_binary) / COUNT(*), 2) AS readmission_rate
FROM patient_data
WHERE discharge_group = 'Left Against Medical Advice (AMA)'
GROUP BY age, gender
ORDER BY readmission_rate DESC;



***Group 5 — Medication & Prior Utilization***

-- 1. Readmission rate by diabetes medication prescribed
SELECT 
    diabetesMed,
    COUNT(*) AS total_patients,
    SUM(readmitted_binary) AS total_readmitted,
    ROUND(100.0 * SUM(readmitted_binary) / COUNT(*), 2) AS readmission_rate
FROM patient_data
GROUP BY diabetesMed
ORDER BY readmission_rate DESC;

-- 2. Readmission rate by medication change
SELECT 
    `change`,
    COUNT(*) AS total_patients,
    SUM(readmitted_binary) AS total_readmitted,
    ROUND(100.0 * SUM(readmitted_binary) / COUNT(*), 2) AS readmission_rate
FROM patient_data
GROUP BY `change`
ORDER BY readmission_rate DESC;

-- 3. Readmission rate by prior inpatient visits
SELECT 
    inpatient_group,
    COUNT(*) AS total_patients,
    SUM(readmitted_binary) AS total_readmitted,
    ROUND(100.0 * SUM(readmitted_binary) / COUNT(*), 2) AS readmission_rate
FROM patient_data
GROUP BY inpatient_group
ORDER BY readmission_rate DESC;

-- 4. Readmission rate by total prior visits group
SELECT 
    prior_visits_group,
    COUNT(*) AS total_patients,
    SUM(readmitted_binary) AS total_readmitted,
    ROUND(100.0 * SUM(readmitted_binary) / COUNT(*), 2) AS readmission_rate
FROM patient_data
GROUP BY prior_visits_group
ORDER BY readmission_rate DESC;

-- 5. Chronic patients — most frequently admitted patients
-- These are your highest risk repeat patients
SELECT 
    patient_nbr,
    age,
    gender,
    diag_1_category,
    number_inpatient,
    num_medications,
    total_prior_visits,
    readmitted_binary
FROM patient_data
WHERE total_prior_visits >= 8
ORDER BY total_prior_visits DESC
LIMIT 10;

-- 6. Most powerful combined risk query
-- Patients with high prior inpatient visits + high medications
-- + elderly age — what is their readmission rate?
SELECT 
    age,
    inpatient_group,
    CASE WHEN num_medications >= 15 THEN '15+ Medications'
         ELSE 'Under 15 Medications' END AS medication_level,
    COUNT(*) AS total_patients,
    SUM(readmitted_binary) AS total_readmitted,
    ROUND(100.0 * SUM(readmitted_binary) / COUNT(*), 2) AS readmission_rate
FROM patient_data
WHERE age IN ('[60-70)', '[70-80)', '[80-90)', '[90-100)')
GROUP BY age, inpatient_group, medication_level
HAVING COUNT(*) >= 30
ORDER BY readmission_rate DESC
LIMIT 10;





